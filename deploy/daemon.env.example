# Скопировать в ~/.config/claude-delta/daemon.env (эта копия — с реальными
# значениями, в git не попадает) и подставить свои значения.

DELTA_ADDR=bot@example.org
DELTA_PASSWORD=app-password
DELTA_PEER_ADDR=me@example.org
DELTA_ACCOUNTS_DIR=/home/USERNAME/work/claude-delta/accounts
DELTA_STORE_DB=/home/USERNAME/work/claude-delta/bridge.sqlite3

# Control-chat "/new-session" (see docs/design.md, "План: control-протокол")
# — all optional, daemon.py has working defaults for this deployment.
# Override for a different one, or leave unset:
# DELTA_SPAWN_BACKENDS=proxy=claude-proxy,deep=claude-deep,mimo=claude-mimo
# DELTA_SPAWN_TMUX_SESSION=main
# DELTA_SPAWN_FOLDERS=vault=~/obsidian_vault,pirelli=~/obsidian_vault/02 Projects/Pirelli
# DELTA_SPAWN_DEFAULT_FOLDER=vault
# DELTA_SPAWN_READY_TIMEOUT_SEC=20
